{
  "name": "contao-community-alliance/dc-general",
  "description": "Universal data container for Contao",
  "license": "LGPL-3.0-or-later",
  "type": "contao-bundle",
  "keywords": [
    "framework",
    "data",
    "container",
    "driver",
    "php",
    "contao"
  ],
  "authors": [
    {
      "name": "Christian Schiffler",
      "email": "c.schiffler@cyberspectrum.de",
      "homepage": "https://www.cyberspectrum.de",
      "role": "Developer"
    },
    {
      "name": "Stefan Heimes",
      "email": "stefan_heimes@hotmail.com",
      "role": "Developer"
    },
    {
      "name": "Ingolf Steinhardt",
      "email": "info@e-spin.de",
      "role": "Developer"
    }
  ],
  "homepage": "https://c-c-a.org/",
  "support": {
    "issues": "https://github.com/contao-community-alliance/dc-general/issues",
    "wiki": "https://de.contaowiki.org/DC_General",
    "source": "https://github.com/contao-community-alliance/dc-general"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "contao-community-alliance/events-contao-bindings": "^6.3",
    "contao-community-alliance/translator": "^2.7",
    "contao-community-alliance/url-builder": "^2.1",
    "contao/core-bundle": "^6.0",
    "contao/image": "^1.2",
    "doctrine/cache": "^2.1",
    "doctrine/dbal": "^3.7 || ^4.3",
    "knplabs/knp-menu": "^3.1",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "symfony/cache": "^7.4 || ^8.0",
    "symfony/cache-contracts": "^3.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/expression-language": "^7.4 || ^8.0",
    "symfony/http-foundation": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/polyfill-mbstring": "^1.0",
    "symfony/routing": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "symfony/security-csrf": "^7.4 || ^8.0",
    "symfony/translation-contracts": "^3.0",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.8",
    "menatwork/contao-multicolumnwizard-bundle": "^3.7",
    "phpcq/runner-bootstrap": "^1.0@dev"
  },
  "autoload": {
    "psr-4": {
      "ContaoCommunityAlliance\\DcGeneral\\": "src/"
    },
    "classmap": [
      "contao-compat/DC_General.php"
    ],
    "files": [
      "src/deprecated-autoload.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "ContaoCommunityAlliance\\DcGeneral\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": false,
      "contao/manager-plugin": false,
      "php-http/discovery": false
    },
    "audit": {
      "ignore": [
        "PKSA-dw7n-x7f5-zf63"
      ]
    }
  },
  "extra": {
    "branch-alias": {
      "dev-feature/contao6": "2.6.x-dev"
    },
    "contao-manager-plugin": "ContaoCommunityAlliance\\DcGeneral\\ContaoManager\\Plugin"
  }
}
