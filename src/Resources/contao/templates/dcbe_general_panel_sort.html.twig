<fieldset class="tl_sorting tl_subpanel {{ rowClass|default('') }}">
    <label for="tl_sort">{{ 'sortBy'|trans({}, 'dc-general') }}:</label>
    <select name="tl_sort" id="tl_sort" class="tl_select">
        {% for arrOption in options %}
            <option value="{{ arrOption.value }}"{{ arrOption.attributes|raw }}>{{ arrOption.content|raw }}</option>
        {% endfor %}
    </select>
</fieldset>
