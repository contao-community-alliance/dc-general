<?php $this->extend('widget_common_picker'); ?>

<?php if ($this->hasOrder): ?>
    <?php $this->block('multi-source-script'); ?>
    <input type="hidden" name="<?= $this->orderName ?>" id="ctrl_order_<?= $this->orderId ?>" value="<?= \implode(',', \array_keys($this->values)) ?>">
    <?php $this->endblock(); ?>
<?php endif; ?>

