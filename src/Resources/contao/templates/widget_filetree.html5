<?php

use Contao\StringUtil;
use Contao\System;

$requestToken = System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue();

// Sorting and removing are handled by the Contao Stimulus controllers, which maintain the value field. A legacy
// "orderField" needs the additional order field to be mirrored, which is done by sortableOrderField.js.
$listAttributes = '';
if ($this->hasOrder) {
    $listAttributes .= ' data-controller="contao--sortable"'
                       . ' data-action="contao--sortable:update->contao--input-map#update"';
}
if ($this->hasOrderField) {
    $listAttributes .= ' data-cca-order-field="ctrl_' . $this->orderId . '"';
}
?>
<div data-controller="contao--input-map" data-contao--input-map-attribute-value="data-id">
    <input type="hidden" name="<?= $this->name ?>" id="ctrl_<?= $this->id ?>" value="<?= $this->value ?>" data-contao--input-map-target="input">
    <div class="selector_container">
        <?php if ($this->hasOrder && \count($this->icons) > 1): ?>
            <p class="sort_hint"><?= $this->translate('dragItemsHint', 'dc-general') ?></p>
        <?php endif; ?>
        <ul id="sort_<?= $this->id ?>" class="<?= \trim(($this->hasOrder ? 'sortable ' : '') . ($this->isGallery ? 'sgallery' : '')) ?>"<?= $listAttributes ?>>
            <?php foreach ($this->icons as $icon): ?>
            <li data-contao--input-map-target="source" data-id="<?= StringUtil::binToUuid($icon['uuid']); ?>">
                <?= $icon['image'] ?>
            </li>
            <?php endforeach; ?>
        </ul>
        <?php if (!$this->readonly): ?>
            <p>
                <a id="ft_<?= $this->name ?>" href="<?= $this->link ?>" class="tl_submit"><?= $this->translate('changeSelection', 'dc-general') ?></a>
            </p>
        <?php endif; ?>
    </div>
    <?php if (!$this->readonly): ?>
        <script>
            document.getElementById("ft_<?= $this->name ?>").addEventListener("click", function (event) {
                event.preventDefault();
                Backend.openModalSelector({
                    "id": "tl_listing",
                    "title": <?= \json_encode(\implode(' ', (array) $this->label), JSON_THROW_ON_ERROR) ?>,
                    "url": this.href + document.getElementById("ctrl_<?= $this->id ?>").value,
                    "callback": function (table, value) {
                        DcGeneral.post(window.location.href, {
                            "action": "reloadFiletree",
                            "name": "<?= $this->id ?>",
                            "value": value.join("\t"),
                            "REQUEST_TOKEN": "<?= $requestToken ?>"
                        }).then(function (response) {
                            var fresh = document.createElement("div");
                            fresh.innerHTML = response.content;
                            DcGeneral.setHtml(
                                document.getElementById("ctrl_<?= $this->id ?>").closest("div"),
                                fresh.querySelector("div").innerHTML
                            );
                        });
                    }
                });
            });
        </script>
    <?php endif; ?>
</div>
