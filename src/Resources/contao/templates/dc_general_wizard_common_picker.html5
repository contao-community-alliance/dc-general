<?php $this->block('modal-button'); ?>
<a id="ft_<?= $this->name ?>" href="<?= $this->popupUrl ?>"><?= $this->html ?></a>
<?php $this->endblock(); ?>

<?php $this->block('modal-script'); ?>
<script>
    document.getElementById("ft_<?= $this->name ?>").addEventListener("click", function (event) {
        event.preventDefault();
        Backend.openModalSelector({
            "id": "tl_listing",
            "title": <?= \json_encode(\implode(' ', (array) $this->label), JSON_THROW_ON_ERROR) ?>,
            "url": this.href + "&value=" + document.getElementById("ctrl_<?= $this->id ?>").value,
            "callback": function (table, value) {
                <?php $this->block('modal-script-post'); ?>
                document.getElementById("ctrl_<?= $this->id ?>").value = value.join(",");
                <?php $this->endblock(); ?>
            }
        });
    });
</script>
<?php $this->endblock(); ?>
