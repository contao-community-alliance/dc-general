{% if language|default and languages|default %}
  {% set fallbackLabel = 'language_selector.fallback'|trans({}, 'dc-general') %}
  {% set fallbackTitle = 'language_selector.fallback_title'|trans({}, 'dc-general') %}
  <form data-turbo="false" action="{{ request }}" id="language_switch" class="tl_form tl_language_panel" method="post">
    <div class="tl_formbody">
      <div class="tl_panel">
        <input type="hidden" name="FORM_SUBMIT" value="language_switch" />
        <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}" />
        <fieldset class="tl_subpanel">
          <label for="selectLanguage"><strong>{{ 'language'|trans({}, 'dc-general') }}: </strong></label>
          <select name="language" id="selectLanguage" class="tl_select" onchange="Backend.autoSubmit('language_switch')">
            {% for langCode, languageName in languages %}
              <option value="{{ langCode }}"{% if langCode == language %} selected="selected"{% endif %}{% if langCode == fallbackLanguage|default %} title="{{ fallbackTitle }}"{% endif %}>
                {{ languageName }}{% if langCode == fallbackLanguage|default %} [{{ fallbackLabel }}]{% endif %}
              </option>
            {% endfor %}
          </select>
          <button type="submit" name="switchLanguage" id="switchLanguage" class="tl_img_submit">{{ submit }}</button>
        </fieldset>
      </div>
    </div>
  </form>
  <div class="clear-content-filter"></div>
{% endif %}
