{#
    FileTreeOrder/PageTreeOrder/TreePickerOrder extend Contao\Widget, not Contao\Template - Contao's
    context factory only exposes a "Template" variable for genuine Template instances
    (ContextFactory::fromContaoTemplate()); a Widget goes through fromClass() instead, which exposes
    its public/protected methods directly as callables (no "Template." prefix needed or valid).
#}
<input type="hidden" name="{{ strName }}" value="{{ getSerializedValue() }}" id="ctrl_{{ strId }}" />
