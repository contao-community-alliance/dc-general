<?php if(isset($this->save)): ?>
    <?= $this->save ?>
<?php endif; ?>
<?php if(isset($this->buttonGroup) && 1 === count($this->buttonGroup)): ?>
    <?= implode('', $this->buttonGroup)?>
<?php endif; ?>
<?php if(isset($this->buttonGroup) && 1 < count($this->buttonGroup)): ?>
    <?php
    /*
     * The toggle is wired through Contao's "contao--toggle-sender"/"contao--toggle-receiver" controllers,
     * the same way the core does it in backend/data_container/buttons.html.twig. The former id "sbtog" made
     * Contao fall back to the deprecated Theme.setupSplitButtonToggle().
     */
    ?>
    <div class="split-button">
        <?= implode('', array_slice($this->buttonGroup, 0, 1)) ?>
        <button type="button" class="d-xl-none split-toggle" tabindex="-1"
                data-controller="contao--toggle-sender"
                data-contao--toggle-sender-contao--toggle-receiver-outlet=".tl_submit_container .split-container"
                data-action="contao--toggle-sender#toggle:prevent">
            <?= $this->toggleIcon ?>
        </button>
        <ul class="split-container invisible"
            data-controller="contao--toggle-receiver"
            data-contao--toggle-receiver-contao--toggle-sender-outlet=".tl_submit_container .split-toggle"
            data-contao--toggle-receiver-inactive-class="invisible"
            data-contao--toggle-receiver-close-delay-param="300"
            data-action="focusin->contao--toggle-receiver#open focusout->contao--toggle-receiver#close click@document->contao--toggle-receiver#documentClick keydown.esc@document->contao--toggle-receiver#close">
            <?php foreach (array_slice($this->buttonGroup, 1) as $button): ?>
                <li>
                    <?= $button ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>
