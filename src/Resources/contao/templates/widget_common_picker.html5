<?php

use Contao\System;
use Contao\StringUtil;

$requestToken = System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue();

$itemsTitle = '';

// Id of the hidden input holding the sort order. The tree picker renders its own one, hence it may override this.
$orderFieldId = isset($this->orderFieldId) ? $this->orderFieldId : ('ctrl_' . $this->orderId);
?>
<input type="hidden" name="<?= $this->name ?>" id="ctrl_<?= $this->id ?>" value="<?= \implode(',', \array_keys($this->values)) ?>">

<?php $this->block('select-container'); ?>
<div class="selector_container">
    <?php if ($this->hasOrder && \count($this->values)):
      $itemsTitle = \sprintf(' title="%s"', $this->dragItemsHint);
      ?>
        <p class="sort_hint">
            <?= $this->dragItemsHint ?>
        </p>
    <?php endif; ?>

    <ul id="sort_<?= $this->id ?>"<?php if ($this->hasOrder): ?> class="sortable" data-controller="contao--sortable" data-cca-order-field="<?= $orderFieldId ?>"<?php endif; ?>>
        <?php foreach ($this->values as $k=>$v): ?>
            <li data-id="<?= $k ?>"<?= $itemsTitle ?>><?= $v ?></li>
        <?php endforeach; ?>
    </ul>
</div>
<?php $this->endblock(); ?>

<?php $this->block('modal-button'); ?>
<?php if (!$this->readonly): ?>
    <p>
        <a id="ft_<?= $this->name ?>" href="<?= $this->popupUrl ?>" class="tl_submit"><?= $this->changeSelection ?></a>
    </p>
<?php endif; ?>
<?php $this->endblock(); ?>

<?php $this->block('modal-script'); ?>
<?php if (!$this->readonly): ?>
<script>
    document.getElementById("ft_<?= $this->name ?>").addEventListener("click", function (event) {
        event.preventDefault();
        Backend.openModalSelector({
            "id": "tl_listing",
            "title": <?= \json_encode(\implode(' ', (array) $this->label), JSON_THROW_ON_ERROR) ?>,
            "url": this.href + document.getElementById("ctrl_<?= $this->id ?>").value,
            "callback": function (table, value) {
                DcGeneral.post("<?= $this->updateUrl ?>" + location.search.replace('?', '&'), {
                    <?php $this->block('modal-script-post'); ?>
                    "action":"DcGeneralLoadSubTree",
                    "name":"<?= $this->id ?>",
                    "providerName":"<?= $this->providerName ?>",
                    "value":value.join(","),
                    "REQUEST_TOKEN":"<?= $requestToken ?>"
                    <?php $this->endblock(); ?>
                }).then(function (response) {
                    var fresh = document.createElement("div");
                    fresh.innerHTML = response.content;
                    DcGeneral.setHtml(
                        document.getElementById("ctrl_<?= $this->id ?>").closest("div"),
                        fresh.querySelector(".widget").innerHTML
                    );
                });
            }
        });
    });
</script>
<?php endif; ?>
<?php $this->endblock(); ?>

<?php $this->block('multi-source-script'); ?>
<?php /* Sorting is handled by the "contao--sortable" Stimulus controller, the order field by sortableOrderField.js. */ ?>
<?php $this->endblock(); ?>
