{% set model = objModel %}
<li class="{{ model.getMeta('dc_gen_tv_level') == 0 ? 'tl_folder' : 'tl_file' }} hover-div{% if select|default(false) %} toggle_select{% endif %}" data-controller="contao--deeplink">
    <div class="tl_left" style="padding-left:{{ model.getMeta('dc_gen_tv_level') * 20 }}px;">
        {% if model.getMeta('dc_gen_tv_children') is same as(true) %}
            <a class="foldable {{ model.getMeta('dc_gen_tv_open') ? ' foldable--open' : '' }}" href="{{ toggleUrl }}" title="{{ toggleTitle }}" data-action="contao--scroll-offset#store" onclick="{{ toggleScript|raw }}">
              {{ backend_icon('chevron-right--dark.svg', '', attrs().set('width', 18).set('height', 18).set('class', 'color-scheme--dark').set('style', 'margin-right:-2px;').set('loading', 'lazy')) }}
              {{ backend_icon('chevron-right.svg', '', attrs().set('width', 18).set('height', 18).set('class', 'color-scheme--light').set('style', 'margin-right:-2px;').set('loading', 'lazy')) }}
            </a>
        {% endif %}
        <div class="tl_pagetree_content{{ publishState|default('') != '' ? ' ' ~ publishState : '' }}">{{ model.getMeta('%content%')[0].content|raw }}</div>
    </div>
    {% if select|default(false) %}
        <div class="tl_right tl_right_nowrap">
            <input type="checkbox" name="models[]" id="models_{{ model.id }}" class="tl_tree_checkbox" value="{{ serializedId }}"{% if serializedId in selectContainer|default([]) %} checked{% endif %} data-contao--check-all-target="input" data-action="focus->contao--scroll-offset#store contao--check-all#toggleInput">
        </div>
    {% else %}
    <div class="tl_right">
        {{ model.getMeta('%buttons%')|raw }}
    </div>
    {% endif %}
    <div style="clear:both;"></div>
</li>
